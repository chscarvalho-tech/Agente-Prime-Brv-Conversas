# Copie para .env (o instalador faz isso). O .env nunca vai para o GitHub.

# Porta local do agente
PORT=3200

# Endereço pelo qual o WA-AKG alcança este agente (HTTPS; o WA-AKG recusa http/localhost).
# Ex.: URL do túnel do Cloudflare ou domínio próprio.
PUBLIC_URL=

# Segredo do webhook (gerado na instalação). O mesmo valor fica cadastrado no WA-AKG.
WEBHOOK_SECRET=

# WA-AKG
WAAKG_URL=http://localhost:3000
WAAKG_API_KEY=
WAAKG_SESSION=

# CRM (os nomes usados aqui aparecem em config/crm.json como ${CRM_URL}, ${CRM_TOKEN})
CRM_URL=
CRM_TOKEN=

# Claude Code: por padrão o agente usa o login do Claude Code desta máquina (limites da assinatura).
# Deixe vazio. Só preencha se quiser usar créditos de API em vez da assinatura.
ANTHROPIC_API_KEY=

# Caminho do executável do Claude Code, se o agente não encontrar sozinho.
CLAUDE_BIN=
